# ==============================================================================
# SISTEM INFORMASI MANAJEMEN RISET (SIM-RISET)
# Environment Variables Template
# Copy file ini menjadi .env.local: cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APP CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (Free Tier)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# URL Project Supabase Anda (contoh: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anon Key (Aman digunakan di client-side browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret Service Role Key (HANYA untuk server-side: cron dispatcher & background worker)
# JANGAN PERNAH diekspos ke NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. CLOUDINARY CONFIGURATION (Free Tier - Storage Bukti Kuitansi & Dokumen)
# Dapatkan dari: Cloudinary Dashboard -> Product Environment Settings -> API Keys
# ------------------------------------------------------------------------------
# Cloud Name akun Cloudinary Anda
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# API Key Cloudinary
CLOUDINARY_API_KEY=123456789012345

# API Secret Cloudinary (Hanya digunakan di server-side untuk generate signed upload)
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Upload Preset (Opsional jika menggunakan unsigned upload atau signed preset)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=sim_riset_receipts

# ------------------------------------------------------------------------------
# 4. TELEGRAM BOT CONFIGURATION (Notification & Reminder Engine)
# Dapatkan dari: Buka Telegram -> Chat dengan @BotFather -> /newbot
# ------------------------------------------------------------------------------
# Token Bot Telegram dari BotFather (contoh: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Username bot Anda tanpa simbol @ (contoh: SimRisetReminderBot)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsernameBot

# Secret token acak untuk memvalidasi request webhook masuk dari Telegram
# Buat string acak (misal: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=your_random_telegram_webhook_secret

# ------------------------------------------------------------------------------
# 5. CRON & SCHEDULER SECURITY
# Digunakan untuk mengamankan endpoint /api/cron/reminder-dispatch
# Supabase pg_cron akan mengirim Authorization: Bearer <CRON_SECRET>
# ------------------------------------------------------------------------------
CRON_SECRET=your_random_cron_secret_key_minimum_32_characters
